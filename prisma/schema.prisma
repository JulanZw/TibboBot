generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guild {
  guildId                       String   @id
  countChannelId                String?
  countNumber                   Int      @default(0)
  highestNumber                 Int      @default(0)
  lastCountUser                 String?
  todayIsChannelId              String?
  birthdayChannelId             String?
  dumbScore                     Int      @default(0)
  daysWithoutHumanParticipation Int      @default(0)
  allowBackups                  Boolean  @default(true)
  yearlyTodayIsReset            Boolean  @default(true)

  pointGiverId                  String?
  pointGiver                    User?    @relation(fields: [pointGiverId], references: [discordId])

  birthdays                     Birthday[]
}

model User {
  discordId   String     @id
  points      BigInt
  char_count  BigInt
  msg_count   Int
  optedout    Boolean    @default(false)

  userStats   Stats?

  pointGiverIn Guild[]

  birthdays   Birthday[]
}

model Birthday {
  birthday   DateTime

  guildId    String
  userId     String

  guild      Guild    @relation(fields: [guildId], references: [guildId])
  user       User     @relation(fields: [userId], references: [discordId])

  @@unique([guildId, userId])
}

model ReactionRoles {
  id        String   @id @default(cuid())
  messageId String
  channelId String
  emoji     String
  role      String
  guildId   String

  @@unique([guildId, messageId, emoji])
}

model Reminders {
  id           String @id @default(cuid())
  userId       String
  message      String
  remindAt     DateTime
  createdAt    DateTime
  remindInterval Intervals @default(NONE)
}

model Stats {
  userId                    String   @unique
  messagesSentThisYear      Int      @default(0)
  charsSentThisYear         BigInt   @default(0)
  todayIsParticipationDays  Int      @default(0)
  todayIsWins               Int      @default(0)
  remindersSet              Int      @default(0)
  catsRequested             Int      @default(0)
  user                      User     @relation(fields: [userId], references: [discordId])
}

enum Intervals {
  DAILY
  WEEKLY
  NONE
}
