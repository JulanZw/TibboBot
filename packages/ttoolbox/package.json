{
  "name": "@julanzw/ttoolbox-discord-framework",
  "version": "1.0.1",
  "description": "TToolbox is a framework I build for my bots. Its based on discord.js but simplifies some things.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "license": "MIT",
  "author": "JulanZw",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "framework",
    "commands"
  ],
  "peerDependencies": {
    "discord.js": "^14.21.0",
    "@prisma/client": "^6.11.1",
    "@discordjs/builders": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.0.14",
    "discord-api-types": "^0.38.16",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0"
  }
}
